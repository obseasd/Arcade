# =============================================================================
# Arcade MAINNET env (Arc chainId 5042). Fill in and split across:
#   - the FORGE deploy (Part 1) -> contracts/.env or the `forge script` command
#   - the VERCEL app runtime (Part 2) -> Vercel Project Settings > Environment
#     Variables (Production), every SECRET marked "Sensitive".
# NEVER commit a filled copy. Placeholders: <fill>.
#
# WALLETS (see P2_SECURITY.md "plan des wallets mainnet"). Generate each with
# `cast wallet new`; NONE may be the personal wallet 0x3a0Dd9. The Safe holds all
# governance + receives every fee.
#   #1 Deployer (throwaway)      -> DEPLOYER_PRIVATE_KEY / PRIVATE_KEY (Part 1 only)
#   #2 Keeper operator (gas)     -> KEEPER_OPERATOR_PRIVATE_KEY
#   #3 Relay / compounder (float)-> COMPOUNDER_OPERATOR_PRIVATE_KEY
#   #4 Claim signer (0 funds)    -> ARCADE_BACKEND_PRIVATE_KEY  (= 0xd3e19E…)
#   #5 Referral payout (budget)  -> REFERRAL_PAYOUT_PRIVATE_KEY
#   Safe (2-of-3, governance+treasury) = 0x0bDE09e3Bfc9b2Ee7b94e56A6A06e0a14706195D
# =============================================================================


# =============================================================================
# PART 1 — FORGE DEPLOY (run once, in order; see MAINNET_CHECKLIST.md section C)
#   Build all profiles first:
#   forge build && FOUNDRY_PROFILE=v3 forge build && FOUNDRY_PROFILE=v4 forge build && unset FOUNDRY_PROFILE
# =============================================================================

# Shared across the deploy scripts:
PRIVATE_KEY=<fill #1 deployer key>             # RedeployDexAndLaunchpad / DeployV4
DEPLOYER_PRIVATE_KEY=<fill #1 deployer key>    # TransferOwnershipToSafe (same key)
SAFE=0x0bDE09e3Bfc9b2Ee7b94e56A6A06e0a14706195D
TREASURY_ADDRESS=0x0bDE09e3Bfc9b2Ee7b94e56A6A06e0a14706195D
OWNER_ADDRESS=0x0bDE09e3Bfc9b2Ee7b94e56A6A06e0a14706195D
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_WETH_ADDRESS=                              # mainnet has NO WETH (leave empty)
ARCADE_BACKEND_SIGNER=<fill #4 signer ADDRESS (0xd3e19E…)>   # RedeployDexAndLaunchpad
TWITTER_SIGNER_ADDRESS=<fill #4 signer ADDRESS (0xd3e19E…)>  # DeployV4 escrow
HANDOVER=true                                  # DeployFeeProtocolManager: set factory owner = mgr

# Filled progressively as each step prints its address (for the later steps +
# the TransferOwnershipToSafe verifier):
V3_FACTORY=<from DeployV3 or Arc canonical>
V3_FACTORY_ADDRESS=<same as V3_FACTORY>        # DeployFeeProtocolManager naming
V3_NPM=<from DeployV3>
V3_LOCKER=<from RedeployDexAndLaunchpad>
V3_LOCKER_ADDRESS=<same as V3_LOCKER>
V2_FACTORY=<from RedeployDexAndLaunchpad>
LAUNCHPAD=<from RedeployDexAndLaunchpad>
TWITTER_ESCROW=<from RedeployDexAndLaunchpad>
FEE_PROTOCOL_MANAGER=<from DeployFeeProtocolManager>
ARCADE_HOOK=<from DeployV4>
V4_ROUTER=<from DeployV4>
AUTO_COMPOUNDER=<from DeployArcadeAutoCompounder>
AIRDROP_DISTRIBUTOR=<from DeployPeripherals>
# After the run: the Safe calls acceptOwnership() on feeProtocolManager,
# autoCompounder, arcadeHook, twitterEscrow (4 x 2-of-3 tx).


# =============================================================================
# PART 2 — VERCEL APP RUNTIME (Production)
# =============================================================================

# ---- Chain switch (THE mainnet flip) ----
NEXT_PUBLIC_DEFAULT_CHAIN=arc
NEXT_PUBLIC_ARC_ENV=mainnet
NEXT_PUBLIC_CCTP_NETWORK=mainnet   # verify Circle attests Arc mainnet burns first
NEXT_PUBLIC_SITE_URL=https://www.arcade.trading

# ---- REQUIRED ----
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=<fill: rotate in the Reown dashboard, restrict to arcade.trading>

# ---- Contract addresses (mirror web/public/deployments.json) ----
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_V2_FACTORY_ADDRESS=<fill>
NEXT_PUBLIC_V2_ROUTER_ADDRESS=<fill>
NEXT_PUBLIC_V2_ZAP_ADDRESS=<fill>
NEXT_PUBLIC_LAUNCHPAD_ADDRESS=<fill>
NEXT_PUBLIC_MULTISWAP_ADDRESS=<fill>
NEXT_PUBLIC_MIGRATED_ROUTER_ADDRESS=<fill>
NEXT_PUBLIC_V3_FACTORY_ADDRESS=<fill>
NEXT_PUBLIC_V3_LOCKER_ADDRESS=<fill>
NEXT_PUBLIC_V3_ROUTER_ADDRESS=<fill>
NEXT_PUBLIC_V3_QUOTER_ADDRESS=<fill>
NEXT_PUBLIC_V3_NPM_ADDRESS=<fill>
NEXT_PUBLIC_V3_ZAP_ADDRESS=<fill>
NEXT_PUBLIC_TOKEN_VAULT_ADDRESS=<fill>
NEXT_PUBLIC_TWITTER_ESCROW_ADDRESS=<fill>
NEXT_PUBLIC_FEE_PROTOCOL_MANAGER_ADDRESS=<fill>
NEXT_PUBLIC_AUTO_COMPOUNDER_ADDRESS=<fill>
# V4 stack
NEXT_PUBLIC_V4_POOL_MANAGER_ADDRESS=<fill: Arc canonical Uniswap V4, NOT an Arcade-owned one>
NEXT_PUBLIC_V4_STATE_VIEW_ADDRESS=<fill>
NEXT_PUBLIC_V4_QUOTER_ADDRESS=<fill>
NEXT_PUBLIC_V4_ROUTER_ADDRESS=<fill>
NEXT_PUBLIC_ARCADE_HOOK_ADDRESS=<fill>
NEXT_PUBLIC_LOCKED_VAULT_ADDRESS=<fill>
# Orbs limit-order stack (redeploy ExchangeV2 allowlisting wallet #2)
NEXT_PUBLIC_ORBS_TWAP_ADDRESS=<fill>
NEXT_PUBLIC_ORBS_EXCHANGE_V2_ADDRESS=<fill>
NEXT_PUBLIC_ORBS_LENS_ADDRESS=<fill>
# WETH: mainnet has none (periphery ETH paths bricked) — leave empty
NEXT_PUBLIC_WETH_ADDRESS=
NEXT_PUBLIC_SEED_ETH_ADDRESS=

# ---- Indexer (Goldsky subgraph pointed at the mainnet contracts) ----
NEXT_PUBLIC_GOLDSKY_URL=<fill: mainnet subgraph GraphQL endpoint>

# ---- SERVICE WALLETS (Sensitive) ----
KEEPER_OPERATOR_PRIVATE_KEY=<fill #2 (gas only)>
COMPOUNDER_OPERATOR_PRIVATE_KEY=<fill #3 (float: gas + 3 USDC/creation + forwards)>
ARCADE_BACKEND_PRIVATE_KEY=<fill #4 (0xd3e19E…) — MUST equal escrow.trustedSigner()>
REFERRAL_PAYOUT_PRIVATE_KEY=<fill #5 (referral budget)>
REFERRAL_PAYOUT_ENABLED=false          # flip to true once #5 is funded
REFERRAL_PROTOCOL_FEE_BPS=1000

# ---- Cron bearer secrets (openssl rand -hex 32 each; fresh for mainnet) ----
KEEPER_CRON_SECRET=<fill>
COMPOUNDER_CRON_SECRET=<fill>
TWEET_LAUNCH_CRON_SECRET=<fill>
STATS_CRON_SECRET=<fill>

# ---- OAuth / HMAC / IPFS / DB ----
ARCADE_OAUTH_STATE_SECRET=<fill: 32+ char random>
TWITTER_CLIENT_ID=<fill>
TWITTER_CLIENT_SECRET=<fill>
PINATA_JWT=<fill>
DATABASE_URL=<fill: mainnet Neon; run migrations, incl. keeper 010/012/013>

# ---- Tweet-to-launch (X API + Anthropic) ----
ANTHROPIC_API_KEY=<fill (without it the parser returns null -> nothing launches)>
TWITTER_BOT_HANDLE=arcadeswap
X_BEARER_TOKEN=<fill>
X_CONSUMER_KEY=<fill>
X_CONSUMER_SECRET=<fill>
X_ACCESS_TOKEN=<fill>
X_ACCESS_SECRET=<fill>

# ---- KMS escrow signer (OPTIONAL, dormant). Leave UNSET to use #4 above.
#      Set only if you later move the signer into AWS KMS (P2_SECURITY.md item 3).
# ARCADE_KMS_KEY_ID=
# ARCADE_KMS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- RPC (dedicated mainnet endpoints first; server-only) ----
NEXT_PUBLIC_ARC_RPC_URL=<fill: dedicated Arc mainnet RPC>
ARC_RPC_URLS=<fill: comma-separated, keyed endpoints first>
ARC_READ_RPC_URLS=<fill>

# ---- Sentry (optional) ----
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# NOTE: crons have NO in-repo scheduler. After the switch, point cron-job.org
# jobs at /api/keeper/cron, /api/compounder/cron, /api/twitter-launch/cron,
# /api/stats/cron with the matching bearer, or nothing auto-runs.
